diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9a748ea..96ee5f2 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,9 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+# a53-4k: -mcpu, not just -march: the macOS target otherwise keeps its Apple default CPU and
+# its LSE atomics (ldadd in lck_grp_reference on QEMU cortex-a53). Plus the erratum 835769 workaround.
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53+crypto -mfix-cortex-a53-835769
 
 
 #
@@ -337,6 +339,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# a53-4k: 4K pages give the kernel only a 38-bit (sub-page L1) VA range, too small for
+# ARM_LARGE_MEMORY's -2TB layout: use the iOS layout Apple's 4K devices used.
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index da0bbba..b6b7c28 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -243,6 +243,28 @@ _jump_table:				// 32 entry jump table, only 2 are used
 	brk #666
 
 
+/*
+ * PFZ_TRYLOCK lock: w10 = old lock word (0 = acquired), lock 0 -> 1 with acquire.
+ * a53-4k: ARMv8.0 CPUs (Cortex-A53) have no LSE casa; use an exclusive pair.
+ * Uses only w10-w13 (caller save, as the PFZ routines require).
+ */
+.macro PFZ_TRYLOCK lock
+#if __ARM_FEATURE_ATOMICS
+	mov		w10, wzr		 // unlock value = w10 = 0
+	mov		w11, #1			 // locked value = w11 = 1
+	casa	w10, w11, [\lock]	 // Atomic CAS with acquire barrier
+#else
+	mov		w11, #1			 // locked value = w11 = 1
+1:	ldaxr	w10, [\lock]		 // old value, acquire
+	cbnz	w10, 2f			 // held: fail with w10 != 0
+	stxr	w13, w11, [\lock]
+	cbnz	w13, 1b
+	b		3f
+2:	clrex
+3:
+#endif
+.endmacro
+
 /*
  * typedef volatile struct {
  *		void *opaque1; <-- ptr to first queue element or null
@@ -269,11 +291,8 @@ _pfz_trylock_and_enqueue:
 	ARM64_STACK_PROLOG
 	PUSH_FRAME
 
-	mov		w10, wzr		 // unlock value = w10 = 0
-	mov		w11, #1			 // locked value = w11 = 1
-
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	PFZ_TRYLOCK x3
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -320,10 +339,7 @@ _pfz_trylock_and_dequeue:
 	PUSH_FRAME
 
 	// Try to grab the lock
-	mov		w10, wzr		 // unlock value = w10 = 0
-	mov		w11, #1			 // locked value = w11 = 1
-
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	PFZ_TRYLOCK x2
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..c0f10dc 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1831,22 +1831,36 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
+#define SWEET_EARLY_FB_SIZE   0xc00000ULL     /* 1080x2400x4 panel, rounded up */
+#define SWEET_EARLY_FB_BLOCKS ((SWEET_EARLY_FB_SIZE + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE)
+#if __ARM_16K_PG__
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#else
+/*
+ * a53-4k: with 4K pages an L1 entry spans 1GB, so VM_MIN_KERNEL_ADDRESS has
+ * no L2 table, and an L2 block is 2MB. Use the blocks right below gVirtBase:
+ * same L1 entry (and L2 table) as the kernel, still in the reserved region.
+ */
+#define SWEET_EARLY_FB_VA ((gVirtBase - SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE) & ~(vm_map_address_t)ARM_TT_L2_OFFMASK)
+#endif
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va >= LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = (0x9c000000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..2b17376 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -680,19 +680,34 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer: 12MB of Normal-NC blocks in the EXISTING V=P L2
+	 * table that covers it (framebuffer and RAM share an L1 entry; another
+	 * create_bootstrap_mapping call would replace the RAM L2 table).
+	 * a53-4k: find that table through the V=P L1 entry (x1) instead of a
+	 * 16K-only fixed offset, and fill as many L2 blocks as the page size
+	 * needs: one 32MB block with 16K pages, six 2MB blocks with 4K pages.
 	 */
 	MOV64	x10, 0x9c000000
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	ldr		x13, [x1, x12, lsl #TTE_SHIFT]
+	and		x9, x13, #(ARM_TTE_TYPE_MASK | ARM_TTE_VALID)
+	cmp		x9, #(ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)
+	b.ne	Lsweet_fb_mapped				// no V=P table there: no splash mapping
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
+	MOV64	x6, ARM_TT_L2_SIZE
+	mov		x9, #((0xc00000 + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE)
+Lsweet_fb_block:
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x11, x11, x6
+	add		x12, x12, #1
+	subs	x9, x9, #1
+	b.ne	Lsweet_fb_block
+Lsweet_fb_mapped:
 #endif
 
 	/* Ensure TTEs are visible */
