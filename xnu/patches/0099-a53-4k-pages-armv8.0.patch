diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 9a748ea..4024017 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,8 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+# a53-4k: ARMv8.0 (no LSE atomics) and the Cortex-A53 erratum 835769 workaround
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8-a+crypto -mfix-cortex-a53-835769
 
 
 #
@@ -337,6 +338,14 @@ ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
 endif
 
+# a53-4k: 4K pages give the kernel only a 38-bit (sub-page L1) VA range, too small for
+# ARM_LARGE_MEMORY's -2TB layout: use the iOS layout Apple's 4K devices used.
+ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY
+ARM64_PLKSEG_ADDR  =0xfffffff004004000
+ARM64_LINK_ADDR    =0xfffffff007004000
+endif
+
 
 CFLAGS_ARM64	= -Darm64 -DARM64 -D__ARM64__ -DLP64 -DPAGE_SIZE_FIXED -DVM_KERNEL_LINK_ADDRESS=$(ARM64_LINK_ADDR) \
 			$(LARGE_MEMORY_DEFINE) -momit-leaf-frame-pointer -fno-strict-aliasing -D__API__=v4 -mkernel
diff --git a/osfmk/mach/arm/vm_param.h b/osfmk/mach/arm/vm_param.h
index c013288..0887182 100644
--- a/osfmk/mach/arm/vm_param.h
+++ b/osfmk/mach/arm/vm_param.h
@@ -133,7 +133,14 @@ extern int PAGE_SHIFT_CONST;
 
 /* system-wide values */
 #define MACH_VM_MIN_ADDRESS_RAW 0x0ULL
-#if defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * a53-4k: the kernel is built for the MacOSX platform, but with 4K pages the
+ * commpage (0xFFFFFC000) must be nested in an L1 block above the user VA max,
+ * which is the iOS layout: use iOS's limit, as iOS userland expects anyway.
+ */
+#define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
+#elif defined(XNU_PLATFORM_MacOSX) || defined(XNU_PLATFORM_DriverKit)
 #define MACH_VM_MAX_ADDRESS_RAW 0x00007FFFFE000000ULL
 #else
 #define MACH_VM_MAX_ADDRESS_RAW 0x0000000FC0000000ULL
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..26017b1 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,8 +33,12 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
-#define __ARM_16K_PG__            1
+/*
+ * a53-4k branch: Cortex-A53-only SoCs (e.g. MediaTek MT8766) are ARMv8.0 with
+ * only the 4K and 64K translation granules: no PAN (v8.1) and no 16K pages.
+ * Page tables as in Apple's own Raspberry Pi 3 (Cortex-A53) config, BCM2837.h.
+ */
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
 
 #define HAS_GIC_V3                1
 
